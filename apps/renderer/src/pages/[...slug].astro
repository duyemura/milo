---
import SeoHead from "../components/SeoHead.astro";
import * as modern from "../../../../templates/modern/registry.ts";
import * as blackout from "../../../../templates/blackout/registry.ts";
import { loadDocuments } from "../lib/load.ts";
import { tokensToCss, Section } from "@milo/schema";

export function getStaticPaths() {
  const gymJson = process.env.GYM_JSON;
  if (!gymJson) throw new Error("renderer: GYM_JSON env var is required");
  const docs = loadDocuments(gymJson);
  return docs.hierarchy.pages.map((page) => ({
    params: { slug: page.slug === "index" ? undefined : page.slug },
    props: { page, docs },
  }));
}

const { page, docs } = Astro.props;

// Template selection — TEMPLATE env var, default to "modern"
const TEMPLATE = process.env.TEMPLATE ?? "modern";
const { Base, COMPONENTS } = TEMPLATE === "blackout" ? blackout : modern;

const id = docs.identity;
const siteUrl = (process.env.SITE_URL ?? id.siteUrl ?? "https://example.com").replace(/\/$/, "");
const canonical = `${siteUrl}/${page.slug === "index" ? "" : page.slug}`;
const tokenCss = tokensToCss(docs.brand);

const ogImage = id.ogImage
  ? id.ogImage.startsWith("http") ? id.ogImage : `${siteUrl}${id.ogImage}`
  : undefined;

const postalAddress = id.addressParts
  ? {
      "@type": "PostalAddress",
      streetAddress: id.addressParts.street,
      addressLocality: id.addressParts.city,
      addressRegion: id.addressParts.state,
      postalCode: id.addressParts.zip,
      addressCountry: id.addressParts.country,
    }
  : id.address
    ? { "@type": "PostalAddress", streetAddress: id.address }
    : undefined;

// Parse sections for @graph extraction. Malformed sections are skipped here
// (warning only) but will throw during render below — the build will still fail.
const validSections = page.sections.flatMap((s) => {
  const result = Section.safeParse({ type: s.section, ...s.content });
  if (!result.success) {
    console.warn(`[renderer] section "${s.section}" on page "${page.slug}" has invalid content — skipping @graph extraction:\n${result.error.message}`);
    return [];
  }
  return [result.data];
});

// Location (first match — location is a page-singleton in practice)
const locData = validSections.find((s) => s.type === "location-map");

// FAQ — merge ALL faq sections into one FAQPage (multi-instance support)
const faqItems = validSections
  .filter((s) => s.type === "faq")
  .flatMap((s) => (s as any).items ?? []);

// Programs — collect from ALL program-cards sections
const allPrograms = validSections
  .filter((s) => s.type === "program-cards")
  .flatMap((s) => (s as any).programs ?? []);

// Coaches — collect from ALL coach-grid sections
const allCoaches = validSections
  .filter((s) => s.type === "coach-grid")
  .flatMap((s) => (s as any).coaches ?? []);

const sameAs = [
  ...(id.socialProfiles ?? []),
  ...(id.googleBusinessProfileUrl ? [id.googleBusinessProfileUrl] : []),
].filter(Boolean);

// OpeningHoursSpecification — prefer typed format from Identity; fall back to plain strings from location-map section
const openingHoursData = id.openingHoursSpecification?.length
  ? { openingHoursSpecification: id.openingHoursSpecification.map((spec) => ({ "@type": "OpeningHoursSpecification", ...spec })) }
  : locData && (locData as any).hours?.length
    ? { openingHours: (locData as any).hours }
    : {};

const localBusiness: Record<string, unknown> = {
  "@type": ["LocalBusiness", "SportsActivityLocation"],
  "@id": `${siteUrl}/#localbusiness`,
  name: id.name,
  url: siteUrl,
  ...(id.email ? { email: id.email } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  ...(id.phone ?? (locData as any)?.phone ? { telephone: id.phone ?? (locData as any)?.phone } : {}),
  ...(postalAddress ? { address: postalAddress } : {}),
  ...openingHoursData,
  ...(id.priceRange ? { priceRange: id.priceRange } : {}),
  ...(id.mapsUrl ? { hasMap: id.mapsUrl } : {}),
  ...(id.geoCoordinates
    ? { geo: { "@type": "GeoCoordinates", latitude: id.geoCoordinates.lat, longitude: id.geoCoordinates.lng } }
    : {}),
  ...(sameAs.length ? { sameAs } : {}),
  ...(id.areaServed?.length ? { areaServed: id.areaServed } : {}),
  ...(id.sports?.length ? { sport: id.sports } : {}),
  ...(id.foundingDate ? { foundingDate: id.foundingDate } : {}),
  description: page.meta.description,
};

const faqSchema = faqItems.length
  ? {
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqItems.map((it: any) => ({
        "@type": "Question",
        name: it.q,
        acceptedAnswer: { "@type": "Answer", text: it.a },
      })),
    }
  : null;

const serviceSchemas = allPrograms.map((p: any) => ({
  "@type": "Service",
  "@id": `${siteUrl}/#service-${p.slug}`,
  name: p.name,
  description: p.description,
  provider: { "@id": `${siteUrl}/#localbusiness` },
}));

const personSchemas = allCoaches.map((c: any) => ({
  "@type": "Person",
  name: c.name,
  ...(c.role ? { jobTitle: c.role } : {}),
  ...(c.bio ? { description: c.bio } : {}),
  ...(c.photo?.src ? { image: c.photo.src } : {}),
  worksFor: { "@id": `${siteUrl}/#localbusiness` },
}));

const pageGraph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${siteUrl}/#website`, name: id.name, url: siteUrl },
    { "@type": "WebPage", "@id": canonical, name: page.title, description: page.meta.description, url: canonical, isPartOf: { "@id": `${siteUrl}/#website` } },
    localBusiness,
    ...(faqSchema ? [faqSchema] : []),
    ...serviceSchemas,
    ...personSchemas,
  ],
};
const pageGraphJson = JSON.stringify(pageGraph).replace(/<\/script>/gi, "<\\/script>");

const B = Base as any;
---
<B tokenCss={tokenCss}>
  <SeoHead
    slot="head"
    title={page.title}
    description={page.meta.description}
    canonical={canonical}
    ogImage={ogImage}
    siteName={id.name}
    themeColor={id.themeColor ?? docs.brand.colors.primary}
    favicon={id.favicon}
  />
  <script slot="head" type="application/ld+json" set:html={pageGraphJson}></script>
  {page.sections.map((s) => {
    const Cmp = COMPONENTS[s.section];
    if (!Cmp) throw new Error(`renderer [${TEMPLATE}]: no component for section "${s.section}"`);
    const parsed = Section.safeParse({ type: s.section, ...s.content });
    if (!parsed.success) {
      throw new Error(`renderer [${TEMPLATE}]: invalid content for section "${s.section}" on page "${page.slug}":\n${parsed.error.message}`);
    }
    const { type: _type, ...props } = parsed.data as any;
    const C = Cmp as any;
    return <C {...props} />;
  })}
</B>
