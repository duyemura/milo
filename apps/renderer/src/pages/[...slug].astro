---
import Base from "../../../../templates/modern/layouts/Base.astro";
import SeoHead from "../components/SeoHead.astro";
import Hero from "../../../../templates/modern/components/Hero.astro";
import Faq from "../../../../templates/modern/components/Faq.astro";
import Cta from "../../../../templates/modern/components/Cta.astro";
import ProgramCards from "../../../../templates/modern/components/ProgramCards.astro";
import CoachGrid from "../../../../templates/modern/components/CoachGrid.astro";
import Schedule from "../../../../templates/modern/components/Schedule.astro";
import LocationMap from "../../../../templates/modern/components/LocationMap.astro";
import StatsBand from "../../../../templates/modern/components/StatsBand.astro";
import Testimonials from "../../../../templates/modern/components/Testimonials.astro";
import Pricing from "../../../../templates/modern/components/Pricing.astro";
import FeatureGrid from "../../../../templates/modern/components/FeatureGrid.astro";
import ContentBlock from "../../../../templates/modern/components/ContentBlock.astro";
import MediaBlock from "../../../../templates/modern/components/MediaBlock.astro";
import ContactForm from "../../../../templates/modern/components/ContactForm.astro";
import LeadForm from "../../../../templates/modern/components/LeadForm.astro";
import LogoStrip from "../../../../templates/modern/components/LogoStrip.astro";
import { loadDocuments } from "../lib/load.ts";
import { tokensToCss } from "@milo/schema";

export function getStaticPaths() {
  const gymJson = process.env.GYM_JSON;
  if (!gymJson) throw new Error("renderer: GYM_JSON env var is required");
  const docs = loadDocuments(gymJson);
  return docs.hierarchy.pages.map((page) => ({
    params: { slug: page.slug === "index" ? undefined : page.slug },
    props: { page, docs },
  }));
}

const { page, docs } = Astro.props;
const id = docs.identity;
const siteUrl = (process.env.SITE_URL ?? id.siteUrl ?? "https://example.com").replace(/\/$/, "");
const canonical = `${siteUrl}/${page.slug === "index" ? "" : page.slug}`;
const tokenCss = tokensToCss(docs.brand);

const ogImage = id.ogImage
  ? id.ogImage.startsWith("http") ? id.ogImage : `${siteUrl}${id.ogImage}`
  : undefined;

// Structured PostalAddress — prefer addressParts, fall back to flat string
const postalAddress = id.addressParts
  ? {
      "@type": "PostalAddress",
      streetAddress: id.addressParts.street,
      addressLocality: id.addressParts.city,
      addressRegion: id.addressParts.state,
      postalCode: id.addressParts.zip,
      addressCountry: id.addressParts.country,
    }
  : id.address
    ? { "@type": "PostalAddress", streetAddress: id.address }
    : undefined;

// Extract location-map section for opening hours fallback
const locSection = page.sections.find((s) => s.section === "location-map");
const loc = locSection?.content as { address?: string; hours?: string[]; phone?: string } | undefined;

// sameAs: social profiles + GBP URL
const sameAs = [
  ...(id.socialProfiles ?? []),
  ...(id.googleBusinessProfileUrl ? [id.googleBusinessProfileUrl] : []),
].filter(Boolean);

const localBusiness: Record<string, unknown> = {
  "@type": ["LocalBusiness", "SportsActivityLocation"],
  "@id": `${siteUrl}/#localbusiness`,
  name: id.name,
  url: siteUrl,
  ...(ogImage ? { image: ogImage } : {}),
  ...(id.phone ?? loc?.phone ? { telephone: id.phone ?? loc?.phone } : {}),
  ...(postalAddress ? { address: postalAddress } : {}),
  ...(loc?.hours?.length ? { openingHours: loc.hours } : {}),
  ...(id.priceRange ? { priceRange: id.priceRange } : {}),
  ...(id.mapsUrl ? { hasMap: id.mapsUrl } : {}),
  ...(id.geoCoordinates
    ? { geo: { "@type": "GeoCoordinates", latitude: id.geoCoordinates.lat, longitude: id.geoCoordinates.lng } }
    : {}),
  ...(sameAs.length ? { sameAs } : {}),
};

const pageGraph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${siteUrl}/#website`, name: id.name, url: siteUrl },
    { "@type": "WebPage", "@id": canonical, name: page.title, description: page.meta.description, url: canonical, isPartOf: { "@id": `${siteUrl}/#website` } },
    localBusiness,
  ],
};
const pageGraphJson = JSON.stringify(pageGraph).replace(/<\/script>/gi, "<\\/script>");

const COMPONENTS: Record<string, unknown> = {
  hero: Hero, faq: Faq, "cta-band": Cta,
  "program-cards": ProgramCards, "coach-grid": CoachGrid, schedule: Schedule,
  "location-map": LocationMap, "stats-band": StatsBand, testimonials: Testimonials,
  pricing: Pricing, "feature-grid": FeatureGrid, "content-block": ContentBlock,
  "media-block": MediaBlock, "contact-form": ContactForm, "lead-form": LeadForm,
  "logo-strip": LogoStrip,
};
---
<Base tokenCss={tokenCss}>
  <SeoHead
    slot="head"
    title={page.title}
    description={page.meta.description}
    canonical={canonical}
    ogImage={ogImage}
    siteName={id.name}
    themeColor={id.themeColor ?? docs.brand.colors.primary}
    favicon={id.favicon}
  />
  <script slot="head" type="application/ld+json" set:html={pageGraphJson}></script>
  {page.sections.map((s) => {
    const Cmp = COMPONENTS[s.section];
    if (!Cmp) throw new Error(`renderer: no component for section "${s.section}"`);
    const C = Cmp as any;
    return <C {...(s.content as any)} />;
  })}
</Base>
