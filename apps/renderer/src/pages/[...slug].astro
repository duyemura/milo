---
import { loadContent, activeTemplate } from "../lib/load-content";
import { getTemplate, resolveSection } from "../lib/resolve";

export async function getStaticPaths() {
  const content = loadContent();
  return content.pages.map((page) => ({
    params: { slug: page.slug === "home" ? undefined : page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const content = loadContent();
const template = await getTemplate(activeTemplate());
const { Base, Nav, Footer } = template;

const sections = page.sections.map((section) => ({
  Component: resolveSection(template, section.type),
  props: section,
}));
---

<Base title={page.seo.title} description={page.seo.description} brand={content.brand} business={content.business}>
  <Nav brand={content.brand} nav={content.nav} />
  {sections.map(({ Component, props }) => <Component {...props} />)}
  <Footer brand={content.brand} footer={content.footer} business={content.business} />
</Base>
