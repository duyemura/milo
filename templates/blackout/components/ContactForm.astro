---
const { heading, sub, fields, submitLabel } = Astro.props;
---

<section class="contact-form">
  <div class="wrapper form-wrap">
    {heading && <h2 class="h2 form-heading" set:html={heading} />}
    {sub && <p class="form-sub">{sub}</p>}
    <form method="post" action="/api/leads" data-milo-form="contact">
      {
        fields.map((f) => (
          <label class="field">
            <span>
              {f.label}
              {f.required && <em aria-hidden="true">*</em>}
            </span>
            {f.kind === "textarea" ? (
              <textarea name={f.name} required={f.required} rows={5} />
            ) : f.kind === "select" ? (
              <select name={f.name} required={f.required}>
                <option value="">Choose…</option>
                {(f.options ?? []).map((o) => (
                  <option value={o}>{o}</option>
                ))}
              </select>
            ) : (
              <input type={f.kind} name={f.name} required={f.required} />
            )}
          </label>
        ))
      }
      <button type="submit" class="btn btn-blue"><span class="btn-label">{submitLabel}</span></button>
    </form>
  </div>
</section>

<style>
  .contact-form {
    background: var(--ink);
    padding: 90px 0 130px;
  }
  .form-wrap {
    max-width: 760px;
  }
  .form-heading {
    margin-bottom: 14px;
  }
  .form-sub {
    font-size: 16px;
    font-weight: 300;
    color: var(--text-dim);
    margin-bottom: 44px;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field span {
    font-size: 12.5px;
    font-weight: 900;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  .field em {
    color: var(--accent);
    font-style: normal;
  }
  input,
  textarea,
  select {
    font: inherit;
    font-size: 16px;
    font-weight: 300;
    color: #fff;
    padding: 15px 16px;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: var(--accent);
  }
  form .btn {
    align-self: flex-start;
    margin-top: 12px;
  }

  @media (max-width: 900px) {
    .contact-form {
      padding: 70px 0 90px;
    }
    form .btn {
      align-self: stretch;
      text-align: center;
    }
  }
</style>
