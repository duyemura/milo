---
const { heading, reviews } = Astro.props;
---

<section class="testimonials">
  <div class="wrapper">
    <h2 class="h2 testi-heading" set:html={heading} />
    <div class="testi-grid" style={`--cols: ${Math.min(reviews.length, 3)}`}>
      {
        reviews.map((r) => (
          <figure class="review">
            <div class="stars" aria-label={`${r.rating ?? 5} out of 5 stars`}>
              {Array.from({ length: r.rating ?? 5 }).map(() => (
                <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M10 1.7 L12.5 7 L18.3 7.7 L14 11.7 L15.1 17.4 L10 14.6 L4.9 17.4 L6 11.7 L1.7 7.7 L7.5 7 Z"
                    fill="var(--accent)"
                  />
                </svg>
              ))}
            </div>
            <blockquote>“{r.quote}”</blockquote>
            <figcaption>
              <strong>{r.name}</strong>
              {r.source && <em>{r.source}</em>}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--ink);
    padding: 90px 0 150px;
  }
  .testi-heading {
    margin-bottom: 64px;
    max-width: 640px;
  }
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 2px;
  }
  .review {
    background: #0d0d0d;
    border-top: 3px solid var(--accent);
    padding: 36px 32px 40px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .stars {
    display: flex;
    gap: 4px;
  }
  blockquote {
    font-size: 16px;
    font-weight: 300;
    line-height: 26px;
    color: var(--text-dim);
    flex: 1;
  }
  figcaption strong {
    display: block;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  figcaption em {
    font-style: normal;
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 900px) {
    .testimonials {
      padding: 70px 0 90px;
    }
    .testi-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
