---
const { stats } = Astro.props;
---

<section class="stats-band">
  <div class="wrapper stats-grid" style={`--cols: ${Math.min(stats.length, 4)}`}>
    {
      stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats-band {
    background: var(--accent);
    padding: 80px 0;
    clip-path: polygon(0 10%, 100% 0, 100% 90%, 0 100%);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 40px;
    text-align: center;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stat-value {
    font-size: 60px;
    font-weight: 900;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .stat-label {
    font-size: 12.5px;
    font-weight: 900;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 900px) {
    .stats-band {
      padding: 64px 0;
    }
    .stats-grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
    .stat-value {
      font-size: 42px;
    }
  }
</style>
