---
const { heading, sub, fields, submitLabel, formId } = Astro.props;
---

<section class="lead-form">
  <div class="wrapper lead-grid">
    <div class="lead-copy">
      <h2 class="h2 lead-heading" set:html={heading} />
      {sub && <p class="lead-sub">{sub}</p>}
      <svg class="lead-arrow" viewBox="0 0 200 160" aria-hidden="true">
        <g fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2">
          <path d="M20 130 L100 50 L100 90 L180 10" />
          <path d="M180 10 L180 60 M180 10 L130 10" />
        </g>
      </svg>
    </div>
    <form method="post" action={`/api/leads/${formId}`} data-milo-form={formId}>
      {
        fields.map((f) => (
          <label class="field">
            <span>
              {f.label}
              {f.required && <em aria-hidden="true">*</em>}
            </span>
            {f.kind === "textarea" ? (
              <textarea name={f.name} required={f.required} rows={4} />
            ) : f.kind === "select" ? (
              <select name={f.name} required={f.required}>
                <option value="">Choose…</option>
                {(f.options ?? []).map((o) => (
                  <option value={o}>{o}</option>
                ))}
              </select>
            ) : (
              <input type={f.kind} name={f.name} required={f.required} />
            )}
          </label>
        ))
      }
      <button type="submit" class="btn btn-onlight"><span class="btn-label">{submitLabel}</span></button>
    </form>
  </div>
</section>

<style>
  .lead-form {
    background: var(--accent);
    padding: 120px 0 130px;
    clip-path: polygon(0 4%, 100% 0, 100% 100%, 0 100%);
  }
  .lead-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: start;
  }
  .lead-heading {
    margin-bottom: 18px;
  }
  .lead-sub {
    font-size: 17px;
    font-weight: 300;
    max-width: 46ch;
    margin-bottom: 40px;
  }
  .lead-arrow {
    width: 200px;
  }
  form {
    background: #fff;
    color: #000;
    padding: 40px 36px 44px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field span {
    font-size: 12.5px;
    font-weight: 900;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  .field em {
    color: var(--accent);
    font-style: normal;
  }
  input,
  textarea,
  select {
    font: inherit;
    font-size: 16px;
    padding: 14px 16px;
    border: 1.5px solid #d8dde3;
    background: #fff;
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 0;
    border-color: var(--accent);
  }
  form .btn {
    margin-top: 10px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .lead-form {
      padding: 90px 0 90px;
    }
    .lead-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
