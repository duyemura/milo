---
interface Props {
  heading?: string;
  address: string;
  mapEmbedUrl?: string;
  hours?: string[];
  phone?: string;
  cta?: { label: string; href: string };
}
const { heading, address, mapEmbedUrl, hours = [], phone, cta } = Astro.props;
---
<section class="location-map">
  {heading && <h2 class="location-map__heading">{heading}</h2>}
  <div class="location-map__body">
    <div class="location-map__info">
      <address class="location-map__address">{address}</address>
      {hours.length > 0 && (
        <ul class="location-map__hours">
          {hours.map((h) => <li>{h}</li>)}
        </ul>
      )}
      {phone && (
        <p class="location-map__phone">
          <a href={`tel:${phone.replace(/\D/g, "")}`}>{phone}</a>
        </p>
      )}
      {cta && (
        <a class="location-map__cta" href={cta.href}>{cta.label}</a>
      )}
    </div>
    <div class="location-map__map">
      {mapEmbedUrl ? (
        <iframe src={mapEmbedUrl} loading="lazy" title="Location map" style="border:0;width:100%;height:100%;"></iframe>
      ) : (
        <div class="location-map__map-placeholder">
          <span class="location-map__map-placeholder-text">Map</span>
        </div>
      )}
    </div>
  </div>
</section>
<style>
  .location-map {
    color: var(--color-on-primary);
    background: var(--color-primary);
  }

  .location-map__heading {
    margin-bottom: var(--space-md);
    color: var(--color-on-primary);
  }

  .location-map__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  @media (max-width: 48rem) {
    .location-map__body { grid-template-columns: 1fr; }
    .location-map__map { order: -1; }
  }

  .location-map__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-md);
  }

  .location-map__address {
    font-style: normal;
    font-family: "Oswald", system-ui, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-primary);
    font-size: 1rem;
  }

  .location-map__hours {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-on-primary);
    opacity: 0.7;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: 0.9375rem;
  }

  .location-map__phone a {
    font-size: 1.25rem;
    font-family: "Oswald", system-ui, sans-serif;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .location-map__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: 0;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    align-self: flex-start;
    transition: opacity 0.2s ease;
  }

  .location-map__map {
    background-color: var(--color-primary);
    border-radius: 0;
    overflow: hidden;
    min-height: 20rem;
  }

  .location-map__map-placeholder {
    min-height: 20rem;
    background: var(--color-on-primary);
    opacity: 0.08;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .location-map__map-placeholder-text {
    color: var(--color-on-primary);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 1;
  }
</style>
