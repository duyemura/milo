---
const { heading, body, image, mediaSide = "right", cta } = Astro.props;
---

<section class="media-block">
  <div class={`wrapper media-grid ${mediaSide === "left" ? "media-left" : ""}`}>
    <div class="media-text">
      <h2 class="h2 media-heading" set:html={heading} />
      <p class="media-body">{body}</p>
      {cta && <a href={cta.href} class="btn btn-blue"><span class="btn-label">{cta.label}</span></a>}
    </div>
    <div class="media-image">
      <img src={image} alt="" loading="eager" />
    </div>
  </div>
</section>

<style>
  .media-block {
    background: var(--ink);
    padding: 90px 0 110px;
  }
  .media-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 80px;
    align-items: center;
  }
  .media-left .media-text {
    order: 2;
  }
  .media-left .media-image {
    order: 1;
  }
  .media-heading {
    margin-bottom: 20px;
  }
  .media-body {
    font-size: 16.5px;
    font-weight: 300;
    line-height: 27px;
    color: var(--text-dim);
    max-width: 48ch;
  }
  .media-text .btn {
    margin-top: 36px;
  }
  .media-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.05);
  }

  @media (max-width: 900px) {
    .media-block {
      padding: 70px 0 80px;
    }
    .media-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .media-left .media-text {
      order: 1;
    }
    .media-left .media-image {
      order: 2;
    }
    .media-text .btn {
      display: block;
      text-align: center;
    }
  }
</style>
