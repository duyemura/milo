---
interface Cta {
  label: string;
  href: string;
}
interface Image { src: string; alt: string; localPath?: string | null }
interface Props {
  heading: string;
  body: string;
  image: Image;
  mediaSide?: "left" | "right";
  cta?: Cta;
}
const { heading, body, image, mediaSide = "right", cta } = Astro.props;
const imgSrc = image.localPath ?? image.src;
---
<section class:list={["media-block", `media-block--${mediaSide}`]}>
  <div class="media-block__text">
    <div class="media-block__heading-wrapper">
      <h2 class="media-block__heading">{heading}</h2>
    </div>
    <p class="media-block__body">{body}</p>
    {cta && (
      <a class="media-block__cta" href={cta.href}>{cta.label}</a>
    )}
  </div>
  <div class="media-block__media">
    <img class="media-block__img" src={imgSrc} alt={image.alt} loading="lazy" />
  </div>
</section>
<style>
  .media-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: stretch;
    padding: var(--space-xl) var(--space-md);
    max-width: 72rem;
    margin-inline: auto;
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .media-block--left .media-block__media {
    order: -1;
  }
  .media-block__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
  }
  .media-block__heading-wrapper {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-md);
  }
  .media-block__heading {
    font-family: Oswald, sans-serif;
    font-size: 2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
    color: var(--color-on-primary);
  }
  .media-block__body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-on-primary);
    opacity: 0.85;
    margin: 0;
  }
  .media-block__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent);
    color: var(--color-on-accent);
    text-decoration: none;
    font-family: Oswald, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 0;
    align-self: flex-start;
  }
  .media-block__cta:hover {
    opacity: 0.9;
  }
  .media-block__media {
    overflow: hidden;
  }
  .media-block__img {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    display: block;
    border-radius: 0;
    object-fit: cover;
  }
  @media (max-width: 48rem) {
    .media-block {
      grid-template-columns: 1fr;
    }
    .media-block__media {
      order: -1;
    }
    .media-block--left .media-block__media {
      order: -1;
    }
    .media-block__img {
      min-height: 16rem;
    }
  }
</style>
