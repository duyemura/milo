---
const { heading, plans } = Astro.props;
---

<section class="pricing">
  <div class="wrapper">
    {heading && <h2 class="h2 pricing-heading" set:html={heading} />}
    <div class="plans" style={`--cols: ${Math.min(plans.length, 3)}`}>
      {
        plans.map((p) => (
          <div class={`plan ${p.featured ? "featured" : ""}`}>
            {p.featured && <span class="badge">Most popular</span>}
            <h3 class="plan-name">{p.name}</h3>
            <div class="plan-price">
              <span class="price">{p.price}</span>
              {p.period && <span class="period">{p.period}</span>}
            </div>
            {p.features.length > 0 && (
              <ul>
                {p.features.map((f) => (
                  <li>
                    <span class="tick">→</span>
                    {f}
                  </li>
                ))}
              </ul>
            )}
            {p.cta && (
              <a href={p.cta.href} class={`btn plan-btn ${p.featured ? "btn-blue" : ""}`}>
                <span class="btn-label">{p.cta.label}</span>
              </a>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--ink);
    padding: 100px 0 140px;
  }
  .pricing-heading {
    margin-bottom: 72px;
    max-width: 640px;
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 2px;
    align-items: stretch;
  }
  .plan {
    position: relative;
    background: #0d0d0d;
    border-top: 3px solid rgba(255, 255, 255, 0.15);
    padding: 44px 38px 48px;
    display: flex;
    flex-direction: column;
  }
  .plan.featured {
    border-top-color: var(--accent);
    background: #101623;
  }
  .badge {
    position: absolute;
    top: 20px;
    right: 24px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
  }
  .plan-name {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 30px;
  }
  .price {
    font-size: 58px;
    font-weight: 900;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .period {
    font-size: 14px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.55);
  }
  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  li {
    display: flex;
    gap: 12px;
    font-size: 15px;
    font-weight: 300;
    color: var(--text-dim);
  }
  .tick {
    color: var(--accent);
    font-weight: 900;
  }
  .plan-btn {
    margin-top: 34px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .pricing {
      padding: 70px 0 90px;
    }
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
