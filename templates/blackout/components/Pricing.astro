---
interface Plan {
  name: string;
  price: string;
  period?: string;
  features: string[];
  cta?: { label: string; href: string };
  featured: boolean;
}

interface Props {
  heading?: string;
  plans: Plan[];
}

const { heading, plans } = Astro.props;
---
<section class="pricing">
  {heading && <h2 class="pricing__heading">{heading}</h2>}
  <ul class="pricing__grid">
    {plans.map((plan) => (
      <li class={`pricing__card${plan.featured ? " pricing__card--featured" : ""}`}>
        <h3 class="pricing__plan-name">{plan.name}</h3>
        <div class="pricing__price-row">
          <span class="pricing__price">{plan.price}</span>
          {plan.period && <span class="pricing__period">{plan.period}</span>}
        </div>
        <ul class="pricing__features">
          {plan.features.map((feature) => (
            <li class="pricing__feature"><span class="pricing__check" aria-hidden="true">✓</span>{feature}</li>
          ))}
        </ul>
        {plan.cta && (
          <a class="pricing__cta" href={plan.cta.href}>{plan.cta.label}</a>
        )}
      </li>
    ))}
  </ul>
</section>
<style>
  .pricing {
    padding: var(--space-xl) var(--space-md);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .pricing__heading {
    text-align: center;
    margin-bottom: var(--space-lg);
    color: var(--color-on-primary);
    font-family: Oswald, sans-serif;
    font-weight: 700;
    font-size: 2.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 72rem;
  }
  .pricing__card {
    background: var(--color-primary);
    border-radius: 0;
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-top: 4px solid var(--color-accent);
    border-left: 1px solid var(--color-on-primary);
    border-right: 1px solid var(--color-on-primary);
    border-bottom: 1px solid var(--color-on-primary);
  }
  .pricing__card--featured {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  .pricing__plan-name {
    margin: 0;
    font-family: Oswald, sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-primary);
  }
  .pricing__card--featured .pricing__plan-name {
    color: var(--color-on-accent);
  }
  .pricing__price-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }
  .pricing__price {
    font-family: Oswald, sans-serif;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
  }
  .pricing__card--featured .pricing__price {
    color: var(--color-on-accent);
  }
  .pricing__period {
    font-size: 0.875rem;
    color: var(--color-on-primary);
    opacity: 0.7;
  }
  .pricing__card--featured .pricing__period {
    color: var(--color-on-accent);
    opacity: 0.8;
  }
  .pricing__features {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .pricing__feature {
    color: var(--color-on-primary);
    font-size: 0.9375rem;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .pricing__card--featured .pricing__feature {
    color: var(--color-on-accent);
  }
  .pricing__check {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
  }
  .pricing__card--featured .pricing__check {
    color: var(--color-on-accent);
  }
  .pricing__cta {
    display: block;
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: 0;
    text-decoration: none;
    font-family: Oswald, sans-serif;
    font-weight: 700;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
  }
  .pricing__card--featured .pricing__cta {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .pricing__cta:hover {
    opacity: 0.9;
  }
</style>
