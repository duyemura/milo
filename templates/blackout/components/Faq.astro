---
const { heading, items } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i: { q: string; a: string }) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<section class="faq">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="wrapper faq-wrap">
    {heading && <h2 class="h2 faq-heading" set:html={heading} />}
    <div class="faq-list">
      {
        items.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="mark" aria-hidden="true">+</span>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--ink);
    padding: 90px 0 130px;
  }
  .faq-wrap {
    max-width: 900px;
  }
  .faq-heading {
    margin-bottom: 56px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .faq-item:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    font-size: 19px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    padding: 26px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .mark {
    font-size: 26px;
    font-weight: 300;
    color: var(--accent);
    transition: transform 0.15s ease;
  }
  details[open] .mark {
    transform: rotate(45deg);
  }
  .faq-answer {
    font-size: 16px;
    font-weight: 300;
    line-height: 26px;
    color: var(--text-dim);
    padding: 0 0 28px;
    max-width: 70ch;
  }

  @media (max-width: 900px) {
    .faq {
      padding: 70px 0 90px;
    }
    summary {
      font-size: 15.5px;
      padding: 20px 0;
    }
  }
</style>
