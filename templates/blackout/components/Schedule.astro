---
const { heading, days } = Astro.props;
---

<section class="schedule">
  <div class="wrapper">
    {heading && <h2 class="h2 schedule-heading" set:html={heading} />}
    <div class="sched-grid">
      {
        days.map((d) => (
          <div class="day">
            <h3 class="day-name">{d.day}</h3>
            {d.slots.length === 0 ? (
              <p class="day-empty">Rest day</p>
            ) : (
              d.slots.map((s) => (
                <div class="slot">
                  <span class="slot-time">{s.time}</span>
                  <span class="slot-name">{s.name}</span>
                </div>
              ))
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .schedule {
    background: var(--ink);
    padding: 100px 0 130px;
  }
  .schedule-heading {
    margin-bottom: 64px;
  }
  .sched-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 2px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .day {
    background: var(--ink);
    padding: 26px 20px 30px;
  }
  .day-name {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .slot {
    display: flex;
    flex-direction: column;
    padding: 9px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .slot-time {
    font-size: 12.5px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.5);
  }
  .slot-name {
    font-size: 15px;
    font-weight: 500;
  }
  .day-empty {
    font-size: 14px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 900px) {
    .schedule {
      padding: 70px 0 90px;
    }
    .sched-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
