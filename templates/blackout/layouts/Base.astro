---
const { title, description, brand, business } = Astro.props;
const accent = brand?.colors?.accent ?? "#1b6bf5";
const jsonLd = business
  ? {
      "@context": "https://schema.org",
      "@type": "ExerciseGym",
      name: brand?.name,
      description,
      address: business.address,
      telephone: business.phone,
      email: business.email,
      sameAs: Object.values(business.socials ?? {}).filter(Boolean),
    }
  : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style is:global define:vars={{ accent }}>
      :root {
        --ink: #000000;
        --paper: #ffffff;
        --text-dim: rgba(255, 255, 255, 0.75);
        --ink-dim: rgba(0, 0, 0, 0.72);
        --font-display: "Outfit", Arial, sans-serif;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: var(--font-display);
        font-size: 17px;
        font-weight: 300;
        line-height: 1.5;
        color: var(--paper);
        background: var(--ink);
      }
      img {
        max-width: 100%;
        display: block;
      }
      a {
        text-decoration: none;
        color: inherit;
      }
      .wrapper {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 48px;
      }
      /* Skewed parallelogram button — the template's signature */
      .btn {
        display: inline-block;
        background: var(--ink);
        color: var(--paper);
        font-family: var(--font-display);
        font-size: 14px;
        font-weight: 900;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 20px 40px;
        border: 0;
        cursor: pointer;
        transform: skewX(-10deg);
        transition: background 0.15s ease;
      }
      .btn > * , .btn-label {
        display: inline-block;
        transform: skewX(10deg);
      }
      .btn:hover {
        background: var(--accent);
      }
      .btn-blue {
        background: var(--accent);
      }
      .btn-blue:hover {
        background: #0d4fd7;
      }
      .btn-onlight {
        background: var(--ink);
      }
      .h2 {
        font-size: 42px;
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.02em;
        text-transform: uppercase;
      }
      .kicker-label {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: -0.02em;
        text-transform: uppercase;
      }
      @media (max-width: 900px) {
        .wrapper {
          padding: 0 22px;
        }
        .h2 {
          font-size: 30px;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
