---
// Template owns: fonts, typography, HTML shell.
// All SEO meta tags + JSON-LD come from the renderer via <slot name="head" />.
import "@fontsource-variable/montserrat/wght.css";
import "@fontsource-variable/inter/wght.css";
interface Props { tokenCss: string }
const { tokenCss } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <style set:html={tokenCss}></style>
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Inter Variable", var(--font-body), system-ui, sans-serif;
        font-size: 1.0625rem;
        line-height: 1.7;
        color: var(--color-text);
        background: var(--color-surface);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: "Montserrat Variable", var(--font-display), sans-serif;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
        margin: 0;
      }

      p { margin: 0; }
      img { max-width: 100%; height: auto; display: block; }
      a { color: var(--color-accent); }

      section { padding: var(--space-xl) var(--space-lg); }
      @media (max-width: 48rem) {
        section { padding: var(--space-lg) var(--space-md); }
      }
    </style>
  </head>
  <body><slot /></body>
</html>
