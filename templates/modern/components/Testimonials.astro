---
interface Review {
  name: string;
  quote: string;
  source?: string;
  rating: number;
}

interface Props {
  heading: string;
  reviews: Review[];
}

const { heading, reviews } = Astro.props;

function stars(rating: number) {
  const filled = Math.min(5, Math.max(0, Math.round(rating)));
  return "★".repeat(filled) + "☆".repeat(5 - filled);
}
---
<section class="testimonials">
  <h2 class="testimonials__heading">{heading}</h2>
  <ul class="testimonials__grid">
    {reviews.map((review) => (
      <li class="testimonials__card">
        <p class="testimonials__quote">{review.quote}</p>
        <footer class="testimonials__footer">
          <span class="testimonials__stars" aria-label={`${review.rating} out of 5 stars`}>{stars(review.rating)}</span>
          <span class="testimonials__name">{review.name}</span>
          {review.source && <span class="testimonials__source">{review.source}</span>}
        </footer>
      </li>
    ))}
  </ul>
</section>
<style>
  .testimonials {
    padding: var(--space-lg);
  }
  .testimonials__heading {
    text-align: center;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .testimonials__card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .testimonials__quote {
    color: var(--color-text);
    margin: 0;
    flex: 1;
    font-style: italic;
  }
  .testimonials__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .testimonials__stars {
    color: var(--color-accent);
    font-size: 1.125rem;
    letter-spacing: 0.05em;
  }
  .testimonials__name {
    font-weight: 600;
    color: var(--color-primary);
  }
  .testimonials__source {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
