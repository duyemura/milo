---
const { heading, logos } = Astro.props;
---

<section class="logo-strip">
  <div class="wrapper">
    {heading && <p class="strip-heading">{heading}</p>}
    <div class="logos">
      {logos.map((l) => <img src={l.src} alt={l.alt} loading="lazy" />)}
    </div>
  </div>
</section>

<style>
  .logo-strip {
    padding: 60px 0 80px;
  }
  .strip-heading {
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 36px;
  }
  .logos {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 56px;
  }
  .logos img {
    height: 56px;
    width: auto;
    border-radius: 8px;
    filter: grayscale(1);
    opacity: 0.65;
    transition: 0.2s ease;
  }
  .logos img:hover {
    filter: none;
    opacity: 1;
  }

  @media (max-width: 900px) {
    .logos {
      gap: 32px;
    }
    .logos img {
      height: 42px;
    }
  }
</style>
