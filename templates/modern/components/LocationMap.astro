---
interface Props {
  heading?: string;
  address: string;
  mapEmbedUrl?: string;
  hours?: string[];
  phone?: string;
  cta?: { label: string; href: string };
}

const {
  heading,
  address,
  mapEmbedUrl,
  hours = [],
  phone,
  cta,
} = Astro.props;
---

<section class="location-map">
  {heading && <h2 class="location-map__heading">{heading}</h2>}
  <div class="location-map__body">
    <div class="location-map__info">
      <address class="location-map__address">{address}</address>

      {hours.length > 0 && (
        <ul class="location-map__hours">
          {hours.map((h) => <li>{h}</li>)}
        </ul>
      )}

      {phone && (
        <p class="location-map__phone">
          <a href={`tel:${phone.replace(/\D/g, "")}`}>{phone}</a>
        </p>
      )}

      {cta && (
        <a class="location-map__cta" href={cta.href}>
          {cta.label}
        </a>
      )}
    </div>

    <div class="location-map__map">
      {mapEmbedUrl
        ? (
          <iframe
            src={mapEmbedUrl}
            loading="lazy"
            title="Location map"
            style="border:0;width:100%;height:100%;"
          ></iframe>
        )
        : (
          <div class="location-map__map-placeholder">
            <span class="location-map__map-placeholder-text">Map</span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .location-map {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .location-map__heading {
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .location-map__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  @media (max-width: 48rem) {
    .location-map__body {
      grid-template-columns: 1fr;
    }

    .location-map__map {
      order: -1;
    }
  }

  .location-map__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .location-map__address {
    font-style: normal;
    font-family: "Montserrat Variable", var(--font-display), sans-serif;
    font-weight: 700;
    color: var(--color-text);
    font-size: 1rem;
  }

  .location-map__hours {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: 0.9375rem;
  }

  .location-map__phone a {
    font-size: 1.25rem;
    font-family: "Montserrat Variable", var(--font-display), sans-serif;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
  }

  .location-map__phone a:hover {
    text-decoration: underline;
  }

  .location-map__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent);
    color: var(--color-surface);
    border-radius: var(--radius-button);
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    align-self: flex-start;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .location-map__cta:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .location-map__map {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    min-height: 20rem;
  }

  .location-map__map-placeholder {
    min-height: 20rem;
    background: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .location-map__map-placeholder-text {
    color: var(--color-muted);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
