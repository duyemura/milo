---
interface Props {
  heading?: string;
  address: string;
  mapEmbedUrl?: string;
  hours?: string[];
  phone?: string;
  cta?: { label: string; href: string };
}

const {
  heading,
  address,
  mapEmbedUrl,
  hours = [],
  phone,
  cta,
} = Astro.props;

const ld: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  address: {
    "@type": "PostalAddress",
    streetAddress: address,
  },
  openingHours: hours,
};
if (phone) ld.telephone = phone;

const ldJson = JSON.stringify(ld).replace(/<\/script>/gi, "<\\/script>");
---

<section class="location-map">
  {heading && <h2 class="location-map__heading">{heading}</h2>}
  <div class="location-map__body">
    <div class="location-map__info">
      <address class="location-map__address">{address}</address>

      {hours.length > 0 && (
        <ul class="location-map__hours">
          {hours.map((h) => <li>{h}</li>)}
        </ul>
      )}

      {phone && (
        <p class="location-map__phone">
          <a href={`tel:${phone.replace(/\D/g, "")}`}>{phone}</a>
        </p>
      )}

      {cta && (
        <a class="location-map__cta" href={cta.href}>
          {cta.label}
        </a>
      )}
    </div>

    <div class="location-map__map">
      {mapEmbedUrl
        ? (
          <iframe
            src={mapEmbedUrl}
            loading="lazy"
            title="Location map"
            style="border:0;width:100%;height:100%;"
          ></iframe>
        )
        : <p class="location-map__address-fallback">{address}</p>
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={ldJson}></script>
</section>

<style>
  .location-map {
    padding: var(--space-lg);
    color: var(--color-text);
    background: var(--color-surface);
  }

  .location-map__heading {
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .location-map__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  @media (max-width: 48rem) {
    .location-map__body {
      grid-template-columns: 1fr;
    }

    .location-map__map {
      order: -1;
    }
  }

  .location-map__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .location-map__address {
    font-style: normal;
    color: var(--color-text);
  }

  .location-map__hours {
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .location-map__phone a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .location-map__phone a:hover {
    text-decoration: underline;
  }

  .location-map__cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-accent);
    color: var(--color-surface);
    border-radius: var(--radius-button);
    text-decoration: none;
    font-weight: 600;
    align-self: flex-start;
  }

  .location-map__cta:hover {
    opacity: 0.9;
  }

  .location-map__map {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    overflow: hidden;
    min-height: 18rem;
  }

  .location-map__address-fallback {
    padding: var(--space-md);
    color: var(--color-muted);
    margin: 0;
  }
</style>
