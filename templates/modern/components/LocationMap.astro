---
const { heading, address, mapEmbedUrl, hours, phone, cta } = Astro.props;
---

<section class="location">
  <div class="wrapper location-grid">
    <div class="location-info">
      {heading && <h2 class="h2 location-heading" set:html={heading} />}
      <p class="location-address">{address}</p>
      {
        hours.length > 0 && (
          <div class="location-hours">
            {hours.map((h) => (
              <p>{h}</p>
            ))}
          </div>
        )
      }
      {phone && <p class="location-phone">{phone}</p>}
      {cta && <a href={cta.href} class="btn">{cta.label}</a>}
    </div>
    <div class="location-map">
      {
        mapEmbedUrl ? (
          <iframe src={mapEmbedUrl} loading="lazy" title={`Map: ${address}`} />
        ) : (
          <div class="map-placeholder">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21 C12 21 5 14.5 5 9.5 A7 7 0 0 1 19 9.5 C19 14.5 12 21 12 21 Z" />
              <circle cx="12" cy="9.5" r="2.6" />
            </svg>
            <p>{address}</p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .location {
    background: #fff;
    padding: 100px 0 130px;
  }
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }
  .location-heading {
    margin-bottom: 28px;
  }
  .location-address {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .location-hours p {
    font-size: 16px;
    color: var(--text-soft);
    line-height: 1.8;
  }
  .location-phone {
    font-size: 16px;
    font-weight: 700;
    margin-top: 16px;
  }
  .location-info .btn {
    margin-top: 40px;
  }
  .location-map iframe,
  .map-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
    border-radius: 16px;
  }
  .map-placeholder {
    background: linear-gradient(135deg, #eef2f6 0%, #e2e8ef 100%);
    display: grid;
    place-content: center;
    gap: 16px;
    justify-items: center;
    text-align: center;
    padding: 24px;
  }
  .map-placeholder p {
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    max-width: 30ch;
  }

  @media (max-width: 900px) {
    .location {
      padding: 70px 0 90px;
    }
    .location-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .location-info .btn {
      width: 100%;
      justify-content: center;
      margin-top: 28px;
    }
  }
</style>
