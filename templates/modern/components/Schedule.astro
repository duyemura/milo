---
const { heading, days } = Astro.props;
---

<section class="schedule">
  <div class="wrapper">
    {heading && <h2 class="h2 schedule-heading" set:html={heading} />}
    <div class="schedule-grid">
      {
        days.map((d) => (
          <div class="day-col">
            <h3 class="day-name">{d.day}</h3>
            {d.slots.length === 0 ? (
              <p class="day-empty">Rest day</p>
            ) : (
              d.slots.map((s) => (
                <div class="slot">
                  <span class="slot-time">{s.time}</span>
                  <span class="slot-name">{s.name}</span>
                </div>
              ))
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .schedule {
    padding: 180px 0 120px;
  }
  .schedule-heading {
    text-align: center;
    margin: 0 auto 64px;
  }
  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
  }
  .day-col {
    background: #fff;
    border-radius: var(--radius-card);
    padding: 24px 18px 28px;
    box-shadow: 0 18px 40px rgba(6, 9, 10, 0.05);
  }
  .day-name {
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 18px;
  }
  .slot {
    display: flex;
    flex-direction: column;
    padding: 10px 0;
    border-top: 1px solid #eef1f4;
  }
  .slot-time {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
  }
  .slot-name {
    font-size: 15px;
    font-weight: 600;
  }
  .day-empty {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .schedule {
      padding: 130px 0 80px;
    }
    .schedule-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
