---
const { heading, coaches } = Astro.props;
---

<section class="coaches">
  <div class="wrapper">
    {heading && <h2 class="h2 coaches-heading" set:html={heading} />}
    <div class="coach-grid" style={`--cols: ${Math.min(coaches.length, 3)}`}>
      {
        coaches.map((c) => (
          <figure class="coach-card">
            {c.photo ? (
              <img src={c.photo} alt={c.name} loading="eager" />
            ) : (
              <div class="coach-placeholder">{c.name.charAt(0)}</div>
            )}
            <figcaption>
              <h3>{c.name}</h3>
              {c.role && <p class="coach-role">{c.role}</p>}
              {c.bio && <p class="coach-bio">{c.bio}</p>}
              {c.certs.length > 0 && (
                <div class="coach-certs">
                  {c.certs.map((cert) => (
                    <span>{cert}</span>
                  ))}
                </div>
              )}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .coaches {
    padding: 180px 0 120px;
  }
  .coaches-heading {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 72px;
  }
  .coach-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 32px;
  }
  .coach-card {
    background: #fff;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(6, 9, 10, 0.05);
    margin: 0;
  }
  .coach-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .coach-placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    font-size: 84px;
    font-weight: 900;
    color: #fff;
    background: var(--navy);
  }
  figcaption {
    padding: 28px 28px 32px;
  }
  figcaption h3 {
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 4px;
  }
  .coach-role {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .coach-bio {
    font-size: 15.5px;
    line-height: 24px;
    color: var(--text-soft);
    margin-bottom: 18px;
  }
  .coach-certs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .coach-certs span {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(4, 100, 252, 0.08);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .coaches {
      padding: 130px 0 80px;
    }
    .coach-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
