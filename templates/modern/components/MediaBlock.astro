---
const { heading, body, image, mediaSide = "right", cta } = Astro.props;
---

<section class="media-block">
  <div class={`wrapper media-grid ${mediaSide === "left" ? "media-left" : ""}`}>
    <div class="media-text">
      <h2 class="h2 media-heading" set:html={heading} />
      <p class="media-body">{body}</p>
      {cta && <a href={cta.href} class="btn">{cta.label}</a>}
    </div>
    <div class="media-image">
      <img src={image} alt="" loading="eager" />
    </div>
  </div>
</section>

<style>
  .media-block {
    padding: 100px 0 150px;
  }
  .media-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .media-left .media-text {
    order: 2;
  }
  .media-left .media-image {
    order: 1;
  }
  .media-heading {
    margin-bottom: 20px;
  }
  .media-body {
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
    color: var(--text-soft);
    max-width: 48ch;
  }
  .media-text .btn {
    margin-top: 36px;
  }
  .media-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
    border: 10px solid #fff;
    box-shadow: 0 24px 50px rgba(6, 9, 10, 0.08);
  }

  @media (max-width: 900px) {
    .media-block {
      padding: 70px 0 90px;
    }
    .media-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .media-left .media-text {
      order: 1;
    }
    .media-left .media-image {
      order: 2;
    }
    .media-text .btn {
      width: 100%;
      justify-content: center;
      margin-top: 28px;
    }
  }
</style>
