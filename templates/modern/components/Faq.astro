---
const { heading, items } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i: { q: string; a: string }) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<section class="faq">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="wrapper faq-wrap">
    {heading && <h2 class="h2 faq-heading" set:html={heading} />}
    <div class="faq-list">
      {
        items.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M3 5.5 L7 9.5 L11 5.5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
              </svg>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 120px 0 140px;
  }
  .faq-wrap {
    max-width: 880px;
  }
  .faq-heading {
    text-align: center;
    margin-bottom: 56px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .faq-item {
    background: #fff;
    border-radius: var(--radius-card);
    box-shadow: 0 18px 40px rgba(6, 9, 10, 0.05);
    padding: 0 28px;
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    font-size: 19px;
    font-weight: 700;
    padding: 24px 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .faq-answer {
    font-size: 16px;
    font-weight: 500;
    line-height: 26px;
    color: var(--text-soft);
    padding: 0 0 26px;
    max-width: 68ch;
  }

  @media (max-width: 900px) {
    .faq {
      padding: 80px 0 90px;
    }
    summary {
      font-size: 16.5px;
      padding: 20px 0;
    }
  }
</style>
