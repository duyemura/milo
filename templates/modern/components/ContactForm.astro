---
const { heading, sub, fields, submitLabel } = Astro.props;
---

<section class="contact-form">
  <div class="wrapper form-wrap">
    {heading && <h2 class="h2 form-heading" set:html={heading} />}
    {sub && <p class="form-sub">{sub}</p>}
    <form method="post" action="/api/leads" data-milo-form="contact">
      {
        fields.map((f) => (
          <label class={`field field-${f.kind}`}>
            <span>
              {f.label}
              {f.required && <em aria-hidden="true">*</em>}
            </span>
            {f.kind === "textarea" ? (
              <textarea name={f.name} required={f.required} rows={5} />
            ) : f.kind === "select" ? (
              <select name={f.name} required={f.required}>
                <option value="">Choose…</option>
                {(f.options ?? []).map((o) => (
                  <option value={o}>{o}</option>
                ))}
              </select>
            ) : (
              <input type={f.kind} name={f.name} required={f.required} />
            )}
          </label>
        ))
      }
      <button type="submit" class="btn">{submitLabel}</button>
    </form>
  </div>
</section>

<style>
  .contact-form {
    padding: 100px 0 130px;
  }
  .form-wrap {
    max-width: 720px;
  }
  .form-heading {
    text-align: center;
    margin-bottom: 16px;
  }
  .form-sub {
    text-align: center;
    font-size: 17px;
    color: var(--text-soft);
    margin-bottom: 48px;
  }
  form {
    background: #fff;
    border-radius: var(--radius-card);
    box-shadow: 0 18px 40px rgba(6, 9, 10, 0.05);
    padding: 44px 40px 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field span {
    font-size: 14px;
    font-weight: 700;
  }
  .field em {
    color: var(--accent);
    font-style: normal;
    margin-left: 2px;
  }
  input,
  textarea,
  select {
    font: inherit;
    font-size: 16px;
    padding: 14px 16px;
    border: 1.5px solid #dde3e8;
    border-radius: 8px;
    background: #fff;
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  form .btn {
    justify-content: center;
    margin-top: 10px;
  }

  @media (max-width: 900px) {
    .contact-form {
      padding: 70px 0 90px;
    }
    form {
      padding: 28px 20px 32px;
    }
  }
</style>
