---
interface Field {
  name: string;
  label: string;
  kind: "text" | "email" | "tel" | "textarea" | "select";
  required: boolean;
  options?: string[];
}
interface Props {
  heading?: string;
  sub?: string;
  fields: Field[];
  submitLabel?: string;
}
const {
  heading,
  sub,
  fields,
  submitLabel = "Send message",
} = Astro.props;
---
<section class="contact-form-section">
  {heading && <h2 class="contact-form-heading">{heading}</h2>}
  {sub && <p class="contact-form-sub">{sub}</p>}
  <form class="contact-form" method="post" action="#">
    {fields.map((field) => (
      <div class="form-field">
        <label for={field.name}>{field.label}</label>
        {field.kind === "textarea" ? (
          <textarea
            id={field.name}
            name={field.name}
            required={field.required || undefined}
          ></textarea>
        ) : field.kind === "select" ? (
          <select
            id={field.name}
            name={field.name}
            required={field.required || undefined}
          >
            {field.options?.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
        ) : (
          <input
            id={field.name}
            type={field.kind}
            name={field.name}
            required={field.required || undefined}
          />
        )}
      </div>
    ))}
    <button type="submit" class="submit-btn">{submitLabel}</button>
  </form>
</section>
<style>
  .contact-form-section {
    padding: var(--space-xl) var(--space-md);
    background: var(--color-surface);
    color: var(--color-on-surface);
    max-width: 40rem;
    margin: 0 auto;
  }
  .contact-form-heading {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }
  .contact-form-sub {
    font-size: 1rem;
    margin-bottom: var(--space-lg);
    color: var(--color-on-surface);
    opacity: 0.8;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .form-field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-on-surface);
  }
  .form-field input,
  .form-field textarea,
  .form-field select {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border, var(--color-primary));
    border-radius: var(--radius-sm, 0.375rem);
    background: var(--color-surface);
    color: var(--color-on-surface);
    font-size: 1rem;
    width: 100%;
    box-sizing: border-box;
  }
  .form-field textarea {
    min-height: 8rem;
    resize: vertical;
  }
  .submit-btn {
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-accent);
    color: var(--color-on-accent, var(--color-surface));
    border: none;
    border-radius: var(--radius-sm, 0.375rem);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    align-self: flex-start;
  }
  .submit-btn:hover {
    opacity: 0.9;
  }
</style>
