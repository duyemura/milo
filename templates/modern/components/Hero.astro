---
const { kicker, heading, sub, cta, image } = Astro.props;
---

<section class="hero" style={`background-image: url('${image}')`}>
  <div class="overlay"></div>
  <div class="wrapper hero-content">
    <div class="hero-text">
      {kicker && <h1 class="kicker">{kicker}</h1>}
      <h2 class="hero-heading" set:html={heading} />
      {sub && <p class="hero-sub">{sub}</p>}
    </div>
    {
      cta && (
        <div class="hero-cta">
          <a href={cta.href} class="btn">
            <span class="play" />
            {cta.label}
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 270px 0 340px;
    background-size: cover;
    background-position: center;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(3, 8, 14, 0.94) 0%,
      rgba(3, 8, 14, 0.82) 40%,
      rgba(3, 8, 14, 0.38) 72%,
      rgba(3, 8, 14, 0.12) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }
  .kicker {
    display: inline-block;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2px;
    line-height: 20px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(6, 9, 10, 0.45);
    padding: 8px 16px;
    margin-bottom: 24px;
  }
  .hero-heading {
    font-size: 49px;
    font-weight: 900;
    line-height: 64px;
    text-transform: capitalize;
    color: #fff;
    max-width: 560px;
    margin-bottom: 24px;
  }
  .hero-sub {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    max-width: 420px;
  }
  .hero-cta {
    flex-shrink: 0;
    padding-bottom: 4px;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 140px 0 160px;
    }
    .hero-content {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }
    .hero-heading {
      font-size: 34px;
      line-height: 44px;
    }
    .hero-cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
