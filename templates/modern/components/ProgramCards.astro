---
const { heading, programs, ctaLabel } = Astro.props;
---

<section class="programs">
  <div class="wrapper">
    {heading && <h2 class="h2 programs-heading" set:html={heading} />}
    <div class="program-list">
      {
        programs.map((p, i) => (
          <div class={`program-row ${i % 2 === 1 ? "reverse" : ""}`}>
            <div class="program-text">
              <h3 class="program-name">{p.name}</h3>
              <p class="program-desc">{p.description}</p>
              <a href={p.href ?? "#"} class="btn">
                {ctaLabel}
              </a>
            </div>
            {p.image && (
              <div class="program-media">
                <img src={p.image} alt={p.name} loading="eager" />
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .programs {
    padding: 160px 0 60px;
  }
  .programs-heading {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 100px;
  }
  .program-list {
    display: flex;
    flex-direction: column;
    gap: 120px;
  }
  .program-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .program-row.reverse .program-text {
    order: 2;
  }
  .program-row.reverse .program-media {
    order: 1;
  }
  .program-name {
    font-size: 38px;
    font-weight: 900;
    line-height: 1.3;
    text-transform: capitalize;
    margin-bottom: 16px;
  }
  .program-desc {
    font-size: 18px;
    font-weight: 500;
    line-height: 27px;
    color: var(--text-soft);
    max-width: 440px;
  }
  .program-text .btn {
    margin-top: 40px;
  }
  .program-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
  }

  @media (max-width: 900px) {
    .programs {
      padding: 90px 0 30px;
    }
    .programs-heading {
      margin-bottom: 56px;
    }
    .program-list {
      gap: 64px;
    }
    .program-row {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .program-row.reverse .program-text {
      order: 1;
    }
    .program-row.reverse .program-media {
      order: 2;
    }
    .program-name {
      font-size: 30px;
    }
    .program-text .btn {
      margin-top: 28px;
    }
  }
</style>
