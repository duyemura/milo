---
interface Program {
  slug: string;
  name: string;
  description: string;
  image?: string;
  href?: string;
}

interface Props {
  heading?: string;
  ctaLabel?: string;
  programs: Program[];
}

const { heading, ctaLabel = "Contact Us For More Info", programs } = Astro.props;
---
<section class="program-cards">
  {heading && <h2 class="program-cards__heading">{heading}</h2>}
  <ul class="program-cards__grid">
    {programs.map((p) => (
      <li class="program-card">
        {p.image && (
          <img
            class="program-card__image"
            src={p.image}
            alt={p.name}
            loading="lazy"
          />
        )}
        <div class="program-card__body">
          <h3 class="program-card__name">{p.name}</h3>
          <p class="program-card__description">{p.description}</p>
          {p.href ? (
            <a class="program-card__cta" href={p.href}>{ctaLabel} →</a>
          ) : (
            <span class="program-card__cta program-card__cta--no-link">{ctaLabel}</span>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
<style>
  .program-cards {
    /* Base rhythm from layout; no padding override needed */
  }

  .program-cards__heading {
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .program-cards__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 480px) {
    .program-cards__grid {
      grid-template-columns: 1fr;
    }
  }

  .program-card {
    background: var(--color-surface);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 2px 12px -4px var(--color-muted);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .program-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 6px 20px -4px var(--color-muted);
  }

  .program-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .program-card__body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-sm);
  }

  .program-card__name {
    font-family: "Montserrat Variable", var(--font-display), sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }

  .program-card__description {
    color: var(--color-muted);
    margin: 0;
    flex: 1;
  }

  .program-card__cta {
    display: inline-block;
    background: none;
    color: var(--color-accent);
    padding: 0;
    text-decoration: none;
    font-weight: 600;
    align-self: flex-start;
    transition: text-decoration 0.15s ease;
  }

  .program-card__cta:hover {
    text-decoration: underline;
  }

  .program-card__cta--no-link {
    color: var(--color-muted);
    cursor: default;
  }
</style>
