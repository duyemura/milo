---
const { heading, sub, fields, submitLabel, formId } = Astro.props;
---

<section class="lead-form">
  <div class="wrapper lead-wrap">
    <div class="lead-copy">
      <h2 class="h2 lead-heading" set:html={heading} />
      {sub && <p class="lead-sub">{sub}</p>}
    </div>
    <form method="post" action={`/api/leads/${formId}`} data-milo-form={formId}>
      {
        fields.map((f) => (
          <label class="field">
            <span>
              {f.label}
              {f.required && <em aria-hidden="true">*</em>}
            </span>
            {f.kind === "textarea" ? (
              <textarea name={f.name} required={f.required} rows={4} />
            ) : f.kind === "select" ? (
              <select name={f.name} required={f.required}>
                <option value="">Choose…</option>
                {(f.options ?? []).map((o) => (
                  <option value={o}>{o}</option>
                ))}
              </select>
            ) : (
              <input type={f.kind} name={f.name} required={f.required} />
            )}
          </label>
        ))
      }
      <button type="submit" class="btn"><span class="play"></span>{submitLabel}</button>
    </form>
  </div>
</section>

<style>
  .lead-form {
    background: var(--navy);
    padding: 170px 0 130px;
  }
  .lead-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .lead-heading {
    color: #fff;
    margin-bottom: 24px;
  }
  .lead-sub {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 46ch;
  }
  form {
    background: #fff;
    border-radius: var(--radius-card);
    padding: 40px 36px 44px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field span {
    font-size: 14px;
    font-weight: 700;
  }
  .field em {
    color: var(--accent);
    font-style: normal;
    margin-left: 2px;
  }
  input,
  textarea,
  select {
    font: inherit;
    font-size: 16px;
    padding: 14px 16px;
    border: 1.5px solid #dde3e8;
    border-radius: 8px;
    background: #fff;
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  form .btn {
    justify-content: center;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .lead-form {
      padding: 120px 0 80px;
    }
    .lead-wrap {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
