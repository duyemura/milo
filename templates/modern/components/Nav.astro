---
const { brand, nav } = Astro.props;
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="logo">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M13 2 L4.5 13.5 H11 L9.5 22 L19.5 9.5 H12.5 L13 2 Z" fill="var(--accent)" />
      </svg>
      <span>{brand.name}</span>
    </a>
    <button class="hamburger" aria-label="Menu" aria-expanded="false">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#06090a" stroke-width="2.4" stroke-linecap="round">
        <path d="M3 6 H21 M3 12 H21 M3 18 H21" />
      </svg>
    </button>
    <nav class="links">
      {
        nav.programs.length > 0 && (
          <div class="dropdown">
            <button class="dropdown-toggle" aria-haspopup="true">
              Programs
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M2.5 4.5 L6 8 L9.5 4.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
              </svg>
            </button>
            <div class="dropdown-list">
              {nav.programs.map((p) => (
                <a href={p.href}>{p.label}</a>
              ))}
            </div>
          </div>
        )
      }
      {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={nav.cta.href} class="nav-cta">{nav.cta.label}</a>
    </nav>
  </div>
</header>

<script>
  const burger = document.querySelector(".hamburger");
  const navEl = document.querySelector(".nav");
  burger?.addEventListener("click", () => {
    const open = navEl!.classList.toggle("open");
    burger.setAttribute("aria-expanded", String(open));
  });
  document.querySelector(".dropdown-toggle")?.addEventListener("click", (e) => {
    if (window.matchMedia("(max-width: 900px)").matches) {
      (e.currentTarget as HTMLElement).closest(".dropdown")?.classList.toggle("open");
    }
  });
</script>

<style>
  .nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    background: #fff;
  }
  .nav-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 16px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #3a4448;
  }
  .hamburger {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 34px;
    font-size: 15px;
    font-weight: 500;
  }
  .links > a:hover {
    color: var(--accent);
  }
  .dropdown {
    position: relative;
  }
  .dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 7px;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 10px 0;
  }
  .dropdown-toggle svg {
    transition: transform 0.15s ease;
  }
  .dropdown:hover .dropdown-toggle svg,
  .dropdown.open .dropdown-toggle svg {
    transform: rotate(180deg);
  }
  .dropdown-list {
    position: absolute;
    top: 100%;
    left: -20px;
    min-width: 210px;
    background: #fff;
    border-radius: 3px;
    padding: 22px 0 20px;
    box-shadow: 0 12px 30px rgba(6, 9, 10, 0.08);
    display: none;
    flex-direction: column;
  }
  .dropdown:hover .dropdown-list,
  .dropdown:focus-within .dropdown-list {
    display: flex;
  }
  .dropdown-list a {
    font-size: 16px;
    font-weight: 500;
    color: #222;
    padding: 10px 20px;
    white-space: nowrap;
  }
  .dropdown-list a:hover {
    color: var(--accent);
  }
  .nav-cta {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    padding: 15px 24px;
    border-radius: var(--radius-btn);
  }
  .nav-cta:hover {
    color: #fff;
  }

  @media (max-width: 900px) {
    .nav-inner {
      padding: 14px 20px;
    }
    .logo {
      font-size: 18px;
    }
    .hamburger {
      display: block;
    }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 10px 0 30px;
      font-size: 16px;
      box-shadow: 0 30px 40px rgba(6, 9, 10, 0.12);
    }
    .nav :global(.open) ~ *,
    .nav.open .links {
      display: flex;
    }
    .links > a,
    .dropdown-toggle {
      padding: 18px 20px;
      text-align: left;
      width: 100%;
    }
    .dropdown-list {
      position: static;
      box-shadow: none;
      padding: 0 0 10px;
    }
    .dropdown:hover .dropdown-list {
      display: none;
    }
    .dropdown.open .dropdown-list,
    .dropdown.open:hover .dropdown-list {
      display: flex;
    }
    .dropdown-list a {
      padding: 12px 36px;
    }
    .nav-cta {
      margin: 12px 20px 0;
      text-align: center;
    }
  }
</style>
