---
const { variant = "default", heading, items } = Astro.props;

const ICONS: Record<string, string> = {
  support:
    '<svg viewBox="0 0 48 48" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14 26 C10 22 8 18 10 14 C12 10 17 10 19 13 L24 19 L29 13 C31 10 36 10 38 14 C40 18 38 22 34 26 L24 36 Z"/><path d="M18 40 C21 42 27 42 30 40"/></svg>',
  fun: '<svg viewBox="0 0 48 48" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M30 8 L34 4 M36 14 L42 12 M34 22 L40 24"/><path d="M10 24 C6 28 6 34 10 38 C14 42 20 42 24 38 L38 24 C42 20 42 14 38 10 C34 6 28 6 24 10 Z"/></svg>',
  varied:
    '<svg viewBox="0 0 48 48" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="18" width="6" height="12" rx="2"/><rect x="36" y="18" width="6" height="12" rx="2"/><rect x="12" y="14" width="6" height="20" rx="2"/><rect x="30" y="14" width="6" height="20" rx="2"/><path d="M18 24 H30"/></svg>',
  barbell:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><rect x="4" y="18" width="6" height="12" rx="2"/><rect x="38" y="18" width="6" height="12" rx="2"/><rect x="10" y="14" width="6" height="20" rx="2"/><rect x="32" y="14" width="6" height="20" rx="2"/><path d="M16 24 H32"/></svg>',
  clock:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="24" cy="24" r="18"/><path d="M24 14 V24 L31 28"/></svg>',
  mobility:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="10" r="4"/><path d="M24 14 V26 M24 18 L14 24 M24 18 L34 24 M24 26 L16 40 M24 26 L32 40"/></svg>',
  locker:
    '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><rect x="10" y="6" width="28" height="36" rx="3"/><path d="M24 6 V42 M16 14 H20 M28 14 H32 M16 20 H20 M28 20 H32"/></svg>',
  default:
    '<svg viewBox="0 0 48 48" fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round"><rect x="6" y="18" width="6" height="12" rx="2"/><rect x="36" y="18" width="6" height="12" rx="2"/><path d="M12 24 H36"/></svg>',
};
const iconFor = (name?: string) => ICONS[name ?? "default"] ?? ICONS.default;
---

<section class={`fg fg-${variant}`}>
  <div class="wrapper">
    {heading && <h2 class="h2 fg-heading">{heading}</h2>}
    <div class="fg-grid" style={`--cols: ${variant === "dark" ? Math.min(items.length, 4) : Math.min(items.length, 3)}`}>
      {
        items.map((item, i) => (
          <div class="fg-item">
            {variant === "numbered" ? (
              <div class="fg-num">{String(i + 1).padStart(2, "0")}</div>
            ) : (
              <div class="fg-icon" set:html={iconFor(item.icon)} />
            )}
            <h3 class="fg-title">{item.title}</h3>
            {item.body && <p class="fg-body">{item.body}</p>}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fg {
    padding: 120px 0;
  }
  .fg-heading {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 64px;
  }
  .fg-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 40px;
  }
  .fg-item {
    background: #fff;
    border-radius: var(--radius-card);
    padding: 48px 40px 56px;
    box-shadow: 0 18px 40px rgba(6, 9, 10, 0.05);
  }
  .fg-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 32px;
  }
  .fg-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .fg-num {
    font-size: 44px;
    font-weight: 900;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 64px;
  }
  .fg-title {
    font-size: 28px;
    font-weight: 700;
    line-height: 35px;
    margin-bottom: 18px;
  }
  .fg-body {
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--text-soft);
  }

  /* cards: raised trio overlapping the section above (hero feature cards) */
  .fg-cards {
    padding: 0 0 40px;
  }
  .fg-cards .fg-grid {
    margin-top: -110px;
    position: relative;
    z-index: 2;
    gap: 28px;
  }
  .fg-cards .fg-item {
    padding: 44px 36px 48px;
  }

  /* dark: navy amenities band */
  .fg-dark {
    background: var(--navy);
    padding: 120px 0 130px;
  }
  .fg-dark .fg-heading {
    color: #fff;
  }
  .fg-dark .fg-grid {
    gap: 28px;
  }
  .fg-dark .fg-item {
    background: rgba(255, 255, 255, 0.04);
    box-shadow: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .fg-dark .fg-icon {
    color: var(--accent);
  }
  .fg-dark .fg-title {
    color: #fff;
    font-size: 22px;
    line-height: 1.3;
  }
  .fg-dark .fg-body {
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 900px) {
    .fg {
      padding: 80px 0;
    }
    .fg-grid {
      grid-template-columns: 1fr !important;
      gap: 24px;
    }
    .fg-heading {
      margin-bottom: 44px;
    }
    .fg-cards .fg-grid {
      margin-top: -60px;
    }
    .fg-num {
      margin-bottom: 32px;
    }
  }
</style>
