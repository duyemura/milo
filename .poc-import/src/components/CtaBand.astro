---
const { heading, ctaText, image } = Astro.props;
---

<section class="cta-band">
  <div class="wrapper cta-inner">
    <div class="cta-text">
      <h2 class="cta-heading" set:html={heading} />
      <a href="#" class="btn"><span class="play"></span>{ctaText}</a>
    </div>
  </div>
  <div class="cta-image" style={`background-image: url('${image}')`}></div>
</section>

<style>
  .cta-band {
    position: relative;
    background: var(--navy);
    padding: 110px 0 150px;
    overflow: hidden;
  }
  .cta-inner {
    position: relative;
    z-index: 1;
  }
  .cta-text {
    max-width: 520px;
  }
  .cta-heading {
    font-size: 44px;
    font-weight: 900;
    line-height: 1.3;
    text-transform: capitalize;
    color: #fff;
    margin-bottom: 48px;
  }
  .cta-image {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 42%;
    background-size: cover;
    background-position: center;
  }
  .cta-image::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--navy) 0%, rgba(0, 11, 39, 0.35) 45%, rgba(0, 11, 39, 0.15) 100%);
  }

  @media (max-width: 900px) {
    .cta-band {
      padding: 70px 0 90px;
    }
    .cta-heading {
      font-size: 32px;
      margin-bottom: 32px;
    }
    .cta-text .btn {
      width: 100%;
      justify-content: center;
    }
    .cta-image {
      width: 100%;
      opacity: 0.18;
    }
    .cta-image::before {
      background: none;
    }
  }
</style>
