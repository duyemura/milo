---
const { heading, reviews } = Astro.props;
---

<section class="testimonials">
  <div class="wrapper">
    <h2 class="testi-heading" set:html={heading} />
    <div class="testi-grid">
      {
        reviews.map((r) => (
          <figure class="review-card">
            <div class="stars" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
                  <path
                    d="M10 1.7 L12.5 7 L18.3 7.7 L14 11.7 L15.1 17.4 L10 14.6 L4.9 17.4 L6 11.7 L1.7 7.7 L7.5 7 Z"
                    fill="#fbbc04"
                  />
                </svg>
              ))}
            </div>
            <blockquote>{r.quote}</blockquote>
            <figcaption>
              <span class="avatar">{r.name.charAt(0)}</span>
              <span>
                <strong>{r.name}</strong>
                <em>{r.source}</em>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding: 100px 0 160px;
  }
  .testi-heading {
    font-size: 44px;
    font-weight: 900;
    font-style: italic;
    line-height: 1.3;
    text-transform: capitalize;
    text-align: center;
    max-width: 820px;
    margin: 0 auto 72px;
  }
  .testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .review-card {
    background: #fff;
    border-radius: var(--radius-card);
    padding: 36px 32px;
    box-shadow: 0 18px 40px rgba(6, 9, 10, 0.05);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .stars {
    display: flex;
    gap: 3px;
  }
  blockquote {
    font-size: 16px;
    font-weight: 500;
    line-height: 26px;
    color: var(--text-soft);
    margin: 0;
    flex: 1;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 18px;
    display: grid;
    place-items: center;
  }
  figcaption strong {
    display: block;
    font-size: 15px;
    font-weight: 700;
  }
  figcaption em {
    display: block;
    font-style: normal;
    font-size: 13px;
    color: var(--ink-soft, #4e5b60);
  }

  @media (max-width: 900px) {
    .testimonials {
      padding: 70px 0 90px;
    }
    .testi-heading {
      font-size: 32px;
      margin-bottom: 44px;
    }
    .testi-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
