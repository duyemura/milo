---

<Base title={`${gym.brand} Athletics — Austin, TX`}>
  <Nav brand={gym.brand} programs={gym.nav.programs} links={gym.nav.links} cta={gym.nav.cta} />
  <Hero {...gym.hero} />
  <ProgramCards heading={gym.programsHeading} programs={gym.programs} ctaText={gym.programCta} />
  <Steps heading={gym.steps.heading} steps={gym.steps.items} />
  <Testimonials {...gym.testimonials} />
  <CtaBand {...gym.ctaBand} />
  <Footer brand={gym.brand} {...gym.footer} />
</Base>
