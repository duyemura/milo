  nav: {
    programs: ["CrossFit", "Olympic Lifting", "Open Gym"],
    links: ["Drop In", "Schedule", "Pricing", "About Us", "Blog", "Contact"],
    cta: "Free Intro",
  },
  hero: {
    kicker: "Strength and Conditioning Gym in Austin",
    heading: "Train hard.<br/>Recover smart.<br/>Live strong.",
