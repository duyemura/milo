---
const { title = "Iron Anchor Athletics" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,900&family=Barlow:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --text: #06090a;
        --text-soft: rgba(6, 9, 10, 0.8);
        --bg: #fafafa;
        --white: #ffffff;
        --accent: #0464fc;
        --navy: #000b27;
        --footer: #00040d;
        --radius-btn: 10px;
        --radius-card: 12px;
        --font-display: "Montserrat", sans-serif;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 500;
        line-height: 1.5;
        color: var(--text);
        background: var(--bg);
      }
      img {
        max-width: 100%;
        display: block;
      }
      a {
        text-decoration: none;
        color: inherit;
      }
      .wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 40px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: var(--accent);
        color: var(--white);
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 700;
        line-height: 20px;
        text-transform: capitalize;
        padding: 24px 32px;
        border-radius: var(--radius-btn);
        transition: background 0.2s ease;
      }
      .btn:hover {
        background: #0353d4;
      }
      .h2 {
        font-family: var(--font-display);
        font-size: 44px;
        font-weight: 900;
        line-height: 1.3;
        text-transform: capitalize;
        color: var(--text);
      }
      .play {
        width: 0;
        height: 0;
        border-top: 7px solid transparent;
        border-bottom: 7px solid transparent;
        border-left: 11px solid #fff;
      }
      @media (max-width: 900px) {
        .wrapper {
          padding: 0 20px;
        }
        .h2 {
          font-size: 32px;
        }
        .btn {
          padding: 20px 28px;
          font-size: 16px;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
