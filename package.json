{
  "name": "milo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "milo": "node apps/cli/src/milo.ts",
    "dev:admin": "pnpm --filter @milo/admin dev",
    "dev:admin:web": "pnpm --filter @milo/admin dev:web",
    "build:admin:web": "pnpm --filter @milo/admin build:web"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@aws-sdk/signature-v4-multi-region": "3.996.43"
    }
  }
}
